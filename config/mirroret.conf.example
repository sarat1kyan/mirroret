# mirroret configuration file
# Copy to /etc/mirroret/mirroret.conf or pass via --config <path>
# All values can also be set as environment variables with the same name.

# -- Paths ---------------------------------------------------------------------

# Base directory for all repository data.
# Default: /srv/mirroret
#MIRRORET_BASE_DIR=/srv/mirroret

# Backup directory.
# Default: /var/backups/mirroret
#MIRRORET_BACKUP_BASE=/var/backups/mirroret

# -- Network -------------------------------------------------------------------

# IP address to use in generated client configs.
# Default: auto-detected via 'ip route get 1.1.1.1'
# Set explicitly if the server has multiple interfaces or if auto-detection
# returns the wrong address.
#MIRRORET_SERVER_IP=192.168.1.10

# Port for the nginx HTTP server (APT/RPM repository browser).
# Default: 8080
#MIRRORET_WEB_PORT=8080

# Port for pypiserver (pip index).
# Default: 8081
#MIRRORET_PIP_PORT=8081

# Port for the Docker registry.
# Default: 5000
#MIRRORET_DOCKER_REGISTRY_PORT=5000

# Port for Verdaccio (npm registry).
# Default: 4873
#MIRRORET_NPM_PORT=4873

# -- Firewall ------------------------------------------------------------------

# Source CIDR to restrict all repository ports to a specific subnet.
# Leave empty to allow from any source (not recommended for production).
# Example: 10.0.0.0/8 or 192.168.1.0/24
#MIRRORET_FIREWALL_SOURCE=

# -- Distribution / distro-specific -------------------------------------------

# Ubuntu codename to mirror (e.g. focal, jammy, noble).
# Default: auto-detected from the running system.
#MIRRORET_UBUNTU_CODENAME=jammy

# RHEL/Rocky major version to sync (e.g. 8, 9).
# Default: auto-detected from the running system.
#MIRRORET_RHEL_VERSION=9

# APT mirror architecture.
# Default: amd64
#MIRRORET_APT_ARCH=amd64

# Number of apt-mirror download threads.
# Default: 10
#MIRRORET_APT_THREADS=10

# -- pip wheel coverage -------------------------------------------------------

# Interpreter/platform pairs to fetch wheels for, ON TOP OF whatever this
# host's own Python matches. Without this a RHEL 9 mirror server (Python 3.9)
# downloads nothing usable for an Ubuntu 24.04 client (Python 3.12) for any
# package with C extensions.
# Syntax: "pythonversion:platformtag ..."  Set to "-" for this host only.
# Default: "3.9:manylinux2014_x86_64 3.11:manylinux2014_x86_64 3.12:manylinux2014_x86_64"
#MIRRORET_PIP_PLATFORMS="3.9:manylinux2014_x86_64 3.12:manylinux2014_x86_64"

# -- Security -----------------------------------------------------------------

# APT client config: path to GPG keyring for package signing.
# When set, generated client configs use 'signed-by=<path>'.
# See docs/SECURITY.md for how to create and distribute a keyring.
#MIRRORET_APT_KEYRING=/etc/apt/keyrings/mirroret.gpg

# APT insecure mode: set to 1 to use trusted=yes in client configs.
# WARNING: This disables GPG signature verification for all APT clients.
# ONLY use this in isolated lab/air-gapped environments.
# Default: 0 (off)
#MIRRORET_APT_INSECURE=0

# RPM client config: URL to GPG key for package verification.
# When set, generated client configs use 'gpgcheck=1' and 'gpgkey=<url>'.
#MIRRORET_RPM_GPGKEY_URL=http://192.168.1.10:8080/RPM-GPG-KEY-mirroret

# RPM insecure mode: set to 1 to use gpgcheck=0 in client configs.
# WARNING: This disables GPG verification for all RPM clients.
# ONLY use this in isolated lab/air-gapped environments.
# Default: 0 (off)
#MIRRORET_RPM_INSECURE=0

# Docker insecure mode: set to 1 to configure insecure-registries.
# WARNING: This disables TLS verification for Docker image pulls.
# ONLY use this in isolated lab/air-gapped environments.
# Default: 0 (off)
#MIRRORET_DOCKER_INSECURE=0

# pip insecure mode: set to 1 to set trusted-host in pip.conf.
# WARNING: This disables certificate verification for pip.
# ONLY use this in isolated lab/air-gapped environments.
# Default: 0 (off)
#MIRRORET_PIP_INSECURE=0

# -- TLS -----------------------------------------------------------------------

# Set to 1 to generate a self-signed certificate during install.
# The cert is stored in MIRRORET_TLS_DIR and used for the nginx HTTPS listener.
# Clients will see an untrusted-CA warning. See docs/SECURITY.md for CA import.
#MIRRORET_TLS_SELF_SIGNED=0

# Alternatively, supply paths to your own cert and key:
#MIRRORET_TLS_CERT=/etc/ssl/certs/mirroret.crt
#MIRRORET_TLS_KEY=/etc/ssl/private/mirroret.key

# HTTPS port for the nginx TLS listener.
# Default: 8443
#MIRRORET_TLS_PORT=8443

# Directory where generated TLS files are stored.
# Default: /etc/mirroret/tls
#MIRRORET_TLS_DIR=/etc/mirroret/tls

# -- GPG signing ---------------------------------------------------------------

# Set to 1 to auto-generate a GPG key for APT/RPM signing if none exists.
# The key is stored in MIRRORET_GPG_HOMEDIR.
# Default: 0 (off)
#MIRRORET_GPG_AUTO=0

# Real Name and Email for the generated GPG key (cosmetic only).
#MIRRORET_GPG_NAME=mirroret
#MIRRORET_GPG_EMAIL=mirroret@localhost

# GPG home directory (isolated from the system keyring).
# Default: /etc/mirroret/gnupg
#MIRRORET_GPG_HOMEDIR=/etc/mirroret/gnupg

# Fingerprint of an existing GPG key to use instead of auto-generating.
# Leave empty to auto-detect or auto-generate.
#MIRRORET_GPG_KEYID=

# -- Package approval workflow -------------------------------------------------

# Set to 1 to enable the staging -> approved workflow for pip, npm and RPM.
# Nothing downloaded reaches a client until an operator promotes it.
#
#   pip  sync -> staging/pip   -> approved/pip        (nginx serves approved/)
#   npm  sync -> staging/npm   -> approved/npm        (also published into
#                                                      Verdaccio on approval)
#   rpm  sync -> redhat/staging -> redhat/mirror      (repodata rebuilt on
#                                                      approval, else invisible)
#
# Manage with:
#   mirroretctl approve list
#   sudo mirroretctl approve all rpm
#   sudo mirroretctl approve pip <name>
#   sudo mirroretctl approve deny rpm <name>
#
# Two consequences to know before enabling:
#
# 1. Verdaccio stops proxying npmjs. It has to: with an uplink configured,
#    clients fetch any package on demand and never touch the approved set.
#    After enabling, an unapproved npm package returns 404 rather than being
#    fetched live. That is the intended behaviour, not a fault.
#
# 2. RPM approval rebuilds repodata for every repo it touches. On a full
#    OL9 baseos+appstream promotion that is a few minutes of CPU.
#
# Default: 0 (off - everything synced is served immediately)
#MIRRORET_APPROVAL_ENABLED=0

# -- Docker registry backend / mode --------------------------------------------

# How to RUN the registry.
# auto - use OS package if available, fall back to container (default)
# native - OS package: docker-distribution (RHEL) or docker-registry (Debian)
# container - registry:2 container via Docker or Podman
#MIRRORET_DOCKER_BACKEND=auto

# Operating mode for the registry.
# cache - pull-through proxy (default). The registry transparently
# forwards and caches every layer pulled by a client. The
# registry REJECTS pushes in this mode; no pre-seed sync
# script is generated.
# hosted - local registry. Accepts docker push from operators and
# sync-docker-images.sh. No upstream proxy.
#MIRRORET_DOCKER_MODE=cache

# Upstream registry for cache mode.
# Default: https://registry-1.docker.io (Docker Hub).
#MIRRORET_DOCKER_UPSTREAM_URL=https://registry-1.docker.io

# Path to a file listing images to pre-seed in hosted mode
# (one per line, # for comments).
# When unset, a small built-in default list is used.
#MIRRORET_DOCKER_IMAGES_FILE=/etc/mirroret/docker-images.txt

# -- APT mirror tool / flavor / upstream --------------------------------------

# ==============================================================================
# WHAT THIS SERVER MIRRORS  (the setting most installs actually need)
# ==============================================================================
#
# These two lines decide which distributions your CLIENTS can install from.
# They have NOTHING to do with what the mirror server itself runs: a RHEL
# server can mirror Ubuntu and Debian, and a Debian server can mirror Oracle
# Linux and Rocky.
#
# Syntax:  flavor:release[:arch,arch...]   (space separated list)
#
# APT flavors:  ubuntu  ubuntu-ports (arm64 etc.)  debian
# RPM flavors:  rocky  almalinux  ol  centos  fedora  epel  rhel
#
# Releases accept either the codename or the version number, so
# "ubuntu:22.04" and "ubuntu:jammy" mean the same thing.
#
# Each APT target mirrors <release>, <release>-updates and
# <release>-security. All releases of one flavor share a single archive
# tree, so mirroring two Ubuntu releases costs far less than twice one.
#
#MIRRORET_APT_TARGETS="ubuntu:jammy ubuntu:noble debian:bookworm"
#MIRRORET_RPM_TARGETS="ol:9 rocky:9 epel:9"
#
# Leave them unset and mirroret mirrors whatever the SERVER runs, which is
# only useful when the server and its clients run the same distribution.
# On a RHEL server with no MIRRORET_APT_TARGETS, no APT mirroring happens at
# all and install.sh says so.
#
# Also mirror <release>-backports.
# Default: 0
#MIRRORET_APT_BACKPORTS=0

# -- APT engine ---------------------------------------------------------------

# Which tool to use for mirroring APT repositories.
# auto - the built-in native engine (default, recommended)
# native - engines/mirroret_apt.py: stdlib Python only, works on any
#              distro, publishes a suite's Release file only after every
#              package it references is on disk
# apt-mirror - legacy: apt-mirror (or apt-mirror2 via pip)
# debmirror - legacy: debmirror
#
# The legacy tools only exist on Debian/Ubuntu hosts, cannot mirror more than
# one flavor, and publish metadata before the packages it describes.
#MIRRORET_APT_MIRROR_TOOL=auto

# Fail the sync instead of warning when a suite's Release signature cannot be
# verified locally. Mirror-side verification needs the matching archive
# keyring (ubuntu-archive-keyring / debian-archive-keyring), which a RHEL
# mirror server does not have. Clients always verify the mirrored signature
# with their own keyring regardless, so this is defence in depth.
# Default: 0
#MIRRORET_APT_REQUIRE_SIGNATURE=0

# Mirror every compression variant of each index instead of only the best
# one. Needed only by clients with a restricted Acquire::CompressionTypes.
# Default: 0
#MIRRORET_APT_ALL_COMPRESSIONS=0

# Mirror source packages (deb-src). Default: 0
#MIRRORET_APT_SOURCE=0

# Mirror Translation-<lang> files (small; apt asks for them). Default: 1
#MIRRORET_APT_TRANSLATIONS=1
#MIRRORET_APT_LANGUAGES="en"

# Mirror AppStream dep11 metadata and icons (tens of GB on Ubuntu universe).
# Default: 0
#MIRRORET_APT_DEP11=0

# Mirror Contents-<arch> indices, used by apt-file. Large. Default: 0
#MIRRORET_APT_CONTENTS=0

# Delete pool files upstream no longer lists. Default: 1
#MIRRORET_APT_DELETE=1

# Parallel download workers for the APT engine. Default: 8
#MIRRORET_APT_JOBS=8

# Scheme used to reach the upstream APT archives: http (default) or https.
# http is what stock sources.list uses and what every public mirror serves -
# the archive is GPG-signed, so the transport is not what protects it.
# Switch to https when your proxy only permits CONNECT on port 443, which
# would otherwise block every APT fetch.
#MIRRORET_APT_SCHEME=https

# Which APT family to mirror. Only used when MIRRORET_APT_TARGETS is unset.
# auto - derive from /etc/os-release on the mirror server (default)
# ubuntu - force Ubuntu upstream (archive.ubuntu.com)
# debian - force Debian upstream (deb.debian.org + deb.debian.org/debian-security)
#MIRRORET_APT_FLAVOR=auto

# Override the upstream archive host. Useful for regional mirrors or
# internal redistributors.
#MIRRORET_APT_UPSTREAM_HOST=archive.ubuntu.com
#MIRRORET_APT_SECURITY_HOST=security.ubuntu.com
# Path of the security archive on that host. Debian serves security from
# /debian-security, NOT from /debian - reusing the main path 404s every
# security suite from bullseye onward.
#MIRRORET_APT_SECURITY_PATH=/debian-security
# Host serving non-amd64 Ubuntu architectures (the ubuntu-ports flavor).
#MIRRORET_APT_PORTS_HOST=ports.ubuntu.com

# Override the components list. Defaults to:
# Ubuntu: "main restricted universe multiverse"
# Debian: "main contrib non-free non-free-firmware"
#MIRRORET_APT_COMPONENTS="main contrib non-free non-free-firmware"

# Mirroret re-signs the mirrored Release files with its own GPG key.
# DEFAULT: 0 (no re-sign - client configs do NOT emit signed-by=mirroret.gpg).
# Set to 1 ONLY if you have set up a re-sign workflow yourself.
#MIRRORET_APT_RESIGN=0

# -- RPM engine ---------------------------------------------------------------

# Which engine mirrors RPM repositories.
# auto - native, unless MIRRORET_RPM_REPOS names repo ids that are not in
#              mirroret's upstream catalog (subscription ids such as
#              rhel-9-for-x86_64-baseos-rpms), in which case reposync is used
#              because only the host's own dnf knows their URLs
# native - engines/mirroret_rpm.py: stdlib Python only, needs no dnf, no
#              createrepo, and no .repo file on this host
# reposync - legacy: needs dnf, and can only mirror repos the mirror SERVER
#              is itself configured and entitled for
#MIRRORET_RPM_ENGINE=auto

# Parallel download workers for the RPM engine. Default: 8
#MIRRORET_RPM_JOBS=8

# TLS client certificate for a subscription CDN (cdn.redhat.com). On a
# registered RHEL host the engine finds /etc/pki/entitlement/*.pem by itself;
# set these only to point somewhere else.
#MIRRORET_RPM_CLIENT_CERT=/etc/pki/entitlement/1234567890.pem
#MIRRORET_RPM_CLIENT_KEY=/etc/pki/entitlement/1234567890-key.pem

# Override an upstream base URL, e.g. to use a regional or internal mirror.
#MIRRORET_RPM_ROCKY_BASE=https://dl.rockylinux.org/pub/rocky
#MIRRORET_RPM_ALMA_BASE=https://repo.almalinux.org/almalinux
#MIRRORET_RPM_ORACLE_BASE=https://yum.oracle.com/repo/OracleLinux
#MIRRORET_RPM_CENTOS_BASE=https://mirror.stream.centos.org
#MIRRORET_RPM_FEDORA_BASE=https://dl.fedoraproject.org/pub/fedora/linux
#MIRRORET_RPM_EPEL_BASE=https://dl.fedoraproject.org/pub/epel
#MIRRORET_RPM_RHEL_CDN=https://cdn.redhat.com/content/dist

# -- RPM flavor / repos -------------------------------------------------------

# Directory name under redhat/mirror/. Only used when MIRRORET_RPM_TARGETS
# is unset; otherwise each target names its own flavor.
#MIRRORET_RPM_FLAVOR=

# Repo ids to mirror, space separated. Only used when MIRRORET_RPM_TARGETS
# names a single target, or with the reposync engine.
#
# Catalog ids per flavor:
#   rocky / almalinux : baseos appstream crb extras devel plus
#                       highavailability resilientstorage nfv rt
#                       (Rocky/Alma 8 use powertools instead of crb)
#   ol (Oracle)       : baseos appstream uek codeready epel addons kvm
#   centos (Stream)   : baseos appstream crb highavailability nfv rt
#   fedora            : everything updates
#   epel              : everything next
#   rhel (needs an entitlement cert)
#                     : baseos appstream codeready supplementary
#MIRRORET_RPM_REPOS="baseos appstream crb"

# -- RPM sync safety (IMPORTANT) -----------------------------------------------

# Architectures to mirror, space separated. "noarch" is always included in
# addition, so architecture-independent packages are never skipped.
# Add i686 if any client installs 32-bit multilib packages. Without it
# "dnf install glibc.i686" on a client fails with "No match for argument",
# because the i686 subpackages were never downloaded. Cost: roughly 10-15
# percent more disk on baseos/appstream.
# Default: x86_64
#MIRRORET_RPM_ARCH="x86_64 i686"

# Keep the upstream-signed repodata instead of rebuilding it locally.
# Only correct for a FULL mirror. With MIRRORET_RPM_NEWEST_ONLY=1 or any
# MIRRORET_RPM_ARCH filter the mirror holds a subset of what upstream
# metadata advertises, so clients resolve packages that were never
# downloaded and fail with 404 or "no match" (this is what made
# glibc.i686 appear broken while the i686 rpms were on disk).
# Set to 1 only if you mirror everything and need repo_gpgcheck=1.
# Default: 0
#MIRRORET_RPM_KEEP_UPSTREAM_METADATA=0

# Only mirror the newest build of each package.
# Default: 1 (ON). Set 0 for full version history - this multiplies disk
# usage several times over and is rarely what you want.
#MIRRORET_RPM_NEWEST_ONLY=1

# Mirror source RPMs (.src.rpm).
# Default: 0 (OFF) - and you almost certainly want it OFF.
# Source RPMs are 400-600 MB EACH. The OL9 appstream repo carries roughly
# 44,000 of them. Enabling this needs MULTIPLE TERABYTES of disk.
#MIRRORET_RPM_SOURCE=0

# Delete local packages that upstream no longer ships.
# Default: 1 (ON) - keeps the mirror tracking upstream and bounds growth.
# Set 0 to accumulate every package ever seen.
#MIRRORET_RPM_DELETE=1

# Abort any sync when free space on the mirror volume drops below this.
# Checked before the run AND between each repo/package. Default: 10 GB.
#MIRRORET_SYNC_MIN_FREE_GB=10

# Repository list to sync. Defaults vary by flavor.
# Rocky/Alma 8: "baseos appstream extras"
# Rocky/Alma 9: "baseos appstream"
# RHEL: "rhel-9-for-x86_64-baseos-rpms rhel-9-for-x86_64-appstream-rpms"
# Oracle Linux 9: "ol9_baseos_latest ol9_appstream ol9_UEKR8 ol9_developer_EPEL"
# Oracle Linux 8: "ol8_baseos_latest ol8_appstream"
# Fedora: "fedora updates"
#MIRRORET_RPM_REPOS="baseos appstream"

# -- npm extras ----------------------------------------------------------------

# Path to a file listing npm packages to sync (one per line, # for comments).
# When unset, a built-in default list is used.
#MIRRORET_NPM_PACKAGES_FILE=

# Set to 1 to allow unauthenticated publish to Verdaccio (isolated networks).
# When 0 (default), npm login is required before publishing.
#MIRRORET_NPM_ALLOW_ANON_PUBLISH=0

# -- Components ----------------------------------------------------------------

# Set to 0 to disable a component entirely.
# Default: 1 (enabled)
#MIRRORET_ENABLE_APT=1
#MIRRORET_ENABLE_RPM=1
#MIRRORET_ENABLE_PIP=1
#MIRRORET_ENABLE_DOCKER=1
#MIRRORET_ENABLE_NPM=1

# -- Behaviour -----------------------------------------------------------------

# Minimum free disk space (GB) required before installation proceeds.
# Set to 0 to skip the check.
# Default: 50
#MIRRORET_MIN_DISK_GB=50

# Non-interactive mode: set to 1 to suppress prompts.
# Confirmations default to no unless confirm_yes() is used.
# Default: 0
#MIRRORET_NON_INTERACTIVE=0

# Log level: DEBUG or INFO.
# Default: INFO
#LOG_LEVEL=INFO

# Daily sync hour (0-23, cron).
# Default: 2
#MIRRORET_SYNC_HOUR=2

# -- Preflight ----------------------------------------------------------------

# Run an optional outbound HTTPS probe during preflight. Off by default
# to keep `--check` fast and to avoid blocking offline installs.
#MIRRORET_PREFLIGHT_NETWORK=0

# Optional per-language sync sources.
#MIRRORET_PIP_PACKAGES_FILE=/etc/mirroret/pip-packages.txt
#MIRRORET_NPM_PACKAGES_FILE=/etc/mirroret/npm-packages.txt

# Address Verdaccio binds to. Must name a host: a bare port makes Verdaccio
# bind "localhost", which resolves to [::1] on a dual-stack host, so the
# registry answers on the server itself and refuses every client.
# Default: 0.0.0.0
#MIRRORET_NPM_BIND_ADDR=0.0.0.0

# -- Retention / cleanup ------------------------------------------------------

# Retention is OPT-IN. Default: keep everything forever.
# Enable it, then set the mode to 'report' (dry-run) first to see what
# would be removed. Flip to 'prune' when you're happy.
#
# Weekly cron runs /srv/mirroret/scripts/cleanup-all.sh Sundays at 03:00
# by default (override MIRRORET_CLEANUP_HOUR / MIRRORET_CLEANUP_DOW).
#
# You can also invoke it manually:
# sudo ./install.sh --cleanup-report # dry-run, prints what would go
# sudo ./install.sh --cleanup # actually delete

#MIRRORET_RETENTION_ENABLE=0 # 1 to enable
#MIRRORET_RETENTION_MODE=report # report | prune

# Per-ecosystem policies (only take effect when RETENTION_ENABLE=1)
#MIRRORET_RPM_KEEP_VERSIONS=3 # keep 3 newest of each RPM (0 = disable)
#MIRRORET_PIP_KEEP_VERSIONS=3 # keep 3 newest wheels/sdists per package
#MIRRORET_NPM_KEEP_DAYS=180 # drop npm tarballs older than N days
#MIRRORET_DOCKER_GC=0 # 1 = weekly registry garbage-collect
                                    # (needs brief registry restart)

# Cron schedule for the weekly cleanup (default Sun @ 03:00).
#MIRRORET_CLEANUP_HOUR=3
#MIRRORET_CLEANUP_DOW=0 # 0=Sun ... 6=Sat

# -- Proxy / corporate CA (needed for unattended cron syncs) -------------------

# Proxy for all upstream fetches. Set these HERE (not just in your shell) so
# the cron-driven syncs and the Verdaccio/pypiserver systemd units inherit
# them - cron and systemd do NOT read /etc/environment or shell rc files.
#http_proxy=http://proxy.example.internal:3128
#https_proxy=http://proxy.example.internal:3128
#no_proxy=localhost,127.0.0.1,::1,10.0.0.0/8,192.168.0.0/16

# Corporate CA bundle for TLS-inspecting proxies. When set, mirroret exports
# it as SSL_CERT_FILE / REQUESTS_CA_BUNDLE / PIP_CERT / NODE_EXTRA_CA_CERTS /
# CURL_CA_BUNDLE in every generated sync script, and injects
# NODE_EXTRA_CA_CERTS into the Verdaccio unit.
# You still need the CA in the OS store: see FIXME-ENVIRONMENT.md.
#MIRRORET_CA_BUNDLE=/etc/pki/tls/cert.pem

# -- Sync timeouts / log retention ---------------------------------------------

# Wall-clock cap on a single reposync invocation. Behind a flaky proxy
# reposync can hang for days while holding the sync lock, which silently
# blocks every later cron run. Default: 6h
#MIRRORET_SYNC_TIMEOUT=6h

# Age out sync logs. logrotate alone cannot bound these because each run
# writes a NEW timestamped filename. cleanup-all.sh deletes older ones.
# Default: 30 days. 0 disables.
#MIRRORET_LOG_KEEP_DAYS=30

# ---- Sync pre-flight / politeness ------------------------------------------

# Estimate download size (metadata only) before syncing and abort if the
# estimate would leave less than MIRRORET_SYNC_MIN_FREE_GB free.
# Default: 1 (on). Set 0 to skip the estimate.
#MIRRORET_SYNC_ESTIMATE=1

# After syncing, ask dnf to read each repo straight off disk. A mirror with
# unreadable metadata is worse than none, because clients only find out at
# install time. Default: 1 (on).
#MIRRORET_SYNC_SMOKE_TEST=1

# nice level for reposync/createrepo. createrepo over tens of thousands of
# packages otherwise pegs every core. ionice idle class is applied too when
# available. Default: 10
#MIRRORET_SYNC_NICE=10

# Wall-clock cap on a single container image pull. Default: 30m
#MIRRORET_DOCKER_PULL_TIMEOUT=30m

# ---- Retention safety ------------------------------------------------------

# Allow retention to delete .tgz files directly out of Verdaccio's storage
# root. OFF by default: raw deletion leaves Verdaccio metadata advertising
# versions that then 404 for clients. Prune properly with npm unpublish.
#MIRRORET_NPM_PRUNE_STORAGE=0

# ---- Install tree location -------------------------------------------------

# cleanup-all.sh needs the mirroret source tree to load lib/retention.sh.
# It records the path at generation time and falls back to a search, but you
# can pin it here if you keep the tree somewhere unusual.
#MIRRORET_INSTALL_DIR=/opt/mirroret
