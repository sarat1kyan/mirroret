# cmd_verify - walk every published Release and confirm every file it lists
# is on disk with the right size. This is what a client's apt-get update
# actually needs, so the check catches the "server publishes a Release
# that names files it never mirrored" class of bug from the server side.
cmd_verify() {
    local script="${SCRIPT_DIR}/scripts/verify-mirror.sh"
