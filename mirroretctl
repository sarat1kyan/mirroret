# ------------------------------------------------------------------ config ----

cmd_config() {
    local what="${1:-show}"
    local conf="${MIRRORET_CONF}"
    case "$what" in
        show)
            if [[ -e "$conf" && ! -f "$conf" ]]; then
                # /dev/null and friends: a deliberate "no config" marker.
                _wa "no config file (${conf} is not a regular file)"
                return 0
            fi
            if [[ ! -f "$conf" ]]; then
                _wa "${conf} does not exist"
                _in "Create it: sudo cp ${SCRIPT_DIR}/config/mirroret.conf.example ${conf}"
                return 0
            fi
            _h "Active settings in ${conf}"
            grep -vE '^\s*(#|$)' "$conf" | sed 's/^/      /'
            ;;
        edit)
            _need_root config edit || return 1
            if [[ -e "$conf" && ! -f "$conf" ]]; then
                _er "no config file (${conf} is not a regular file)"
                _in "Point MIRRORET_CONF at a real path, or unset it."
                return 1
            fi
            [[ -f "$conf" ]] || { mkdir -p "$(dirname "$conf")"; cp "${SCRIPT_DIR}/config/mirroret.conf.example" "$conf"; }
            "${EDITOR:-vi}" "$conf"
            _in "Apply with: sudo mirroretctl upgrade"
            ;;
        path)
            printf '%s\n' "$conf"
            ;;
        diff)
            # Show where what is RUNNING disagrees with what the conf asks
            # for. The generated target specs are the source of truth for
            # what actually syncs, so compare against those rather than
            # grepping one legacy script.
            _cli_config_diff "$conf"
            ;;
        *) _er "Usage: mirroretctl config {show|edit|path|diff}"; return 1 ;;
    esac
}

# _cli_config_diff <conf> - conf settings vs the live generated state.
_cli_config_diff() {
    local conf="$1"
    local rc=0

    _h "Targets: requested vs generated"
    local want_apt want_rpm
    want_apt="$(_conf_val "$conf" MIRRORET_APT_TARGETS)"
    want_rpm="$(_conf_val "$conf" MIRRORET_RPM_TARGETS)"
    _in "conf MIRRORET_APT_TARGETS = ${want_apt:-(unset - derived from this host)}"
    _in "conf MIRRORET_RPM_TARGETS = ${want_rpm:-(unset - derived from this host)}"

    local have_apt="" have_rpm="" spec
    for spec in "${TARGETS_DIR}"/apt-*.json; do
        [[ -f "$spec" ]] && have_apt+=" $(mirroret_json_field "$spec" id)"
    done
    for spec in "${TARGETS_DIR}"/rpm-*.json; do
        [[ -f "$spec" ]] && have_rpm+=" $(mirroret_json_field "$spec" id)"
    done
    _in "generated APT specs =${have_apt:- (none)}"
    _in "generated RPM specs =${have_rpm:- (none)}"

    # A target named in the conf with no spec means upgrade was never run.
    local t flavor release want_id missing=""
    for t in ${want_apt}; do
        flavor="${t%%:*}"; release="${t#*:}"; release="${release%%:*}"
        [[ "$flavor" == "$t" ]] && continue
        # Same id lib/targets.sh writes into the spec: <dir>-<codename>.
        # A bare flavor substring match let "ubuntu-noble" satisfy a newly
        # added ubuntu:jammy, so the missing spec was never reported.
        want_id="$(apt_flavor_dir "${flavor}")-$(apt_codename_for "${flavor}" "${release}")"
        [[ " ${have_apt} " == *" ${want_id} "* ]] || missing+=" ${t}"
    done
    for t in ${want_rpm}; do
        flavor="${t%%:*}"; release="${t#*:}"; release="${release%%:*}"
        [[ "$flavor" == "$t" ]] && continue
        want_id="${flavor}${release}"
        [[ " ${have_rpm} " == *" ${want_id} "* ]] || missing+=" ${t}"
    done
    if [[ -n "${missing}" ]]; then
        _er "requested but NOT generated:${missing}"
        _in "  Run: sudo mirroretctl upgrade"
        rc=1
    else
        _ok "every requested target has a generated spec"
    fi

    _h "Sync scripts present"
    local sc found=0 notexec=""
    for sc in sync-apt-repos.sh sync-rpm-repos.sh sync-apt-debmirror.sh \
              sync-redhat-repos.sh sync-pip-packages.sh sync-npm-packages.sh \
              sync-docker-images.sh sync-all.sh; do
        [[ -f "${SCRIPTS_DIR}/${sc}" ]] || continue
        found=1
        # Present but not executable is its own failure, and a common one:
        # a zip transfer does not preserve the execute bit, so the scripts
        # are all there and cron silently runs none of them.
        if [[ -x "${SCRIPTS_DIR}/${sc}" ]]; then
            _in "${sc}"
        else
            _in "${sc}  (NOT EXECUTABLE)"
            notexec+=" ${sc}"
        fi
    done
    if [[ "$found" -eq 0 ]]; then
        _er "no generated sync scripts at all"
        _in "  Run: sudo mirroretctl upgrade"
        rc=1
    fi
    if [[ -n "${notexec}" ]]; then
        _er "present but not executable:${notexec}"
        _in "  cron runs none of these. A zip transfer drops the execute bit."
        _in "  Fix: sudo chmod +x ${SCRIPTS_DIR}/*.sh"
        rc=1
    fi

    # An APT/RPM target with no matching sync script cannot ever run.
    if [[ -n "${have_apt}" ]] && [[ ! -f "${SCRIPTS_DIR}/sync-apt-repos.sh" ]] \
       && [[ ! -f "${SCRIPTS_DIR}/sync-apt-debmirror.sh" ]]; then
        _er "APT targets exist but there is no APT sync script"
        _in "  Run: sudo mirroretctl upgrade"
        rc=1
    fi
    if [[ -n "${have_rpm}" ]] && [[ ! -f "${SCRIPTS_DIR}/sync-rpm-repos.sh" ]] \
       && [[ ! -f "${SCRIPTS_DIR}/sync-redhat-repos.sh" ]]; then
        _er "RPM targets exist but there is no RPM sync script"
        _in "  Run: sudo mirroretctl upgrade"
        rc=1
    fi

    _h "Sync knobs: conf vs generated specs"
    local key spec_val
    for spec in "${TARGETS_DIR}"/rpm-*.json; do
        [[ -f "$spec" ]] || continue
        _in "$(basename "$spec"):"
        for key in arches newest_only sources delete min_free_gb; do
            spec_val="$(mirroret_json_field "$spec" "$key")"
            printf '        %-14s %s\n' "${key}" "${spec_val}"
        done
    done
    for spec in "${TARGETS_DIR}"/apt-*.json; do
        [[ -f "$spec" ]] || continue
        _in "$(basename "$spec"):"
        for key in arches components sources delete min_free_gb; do
            spec_val="$(mirroret_json_field "$spec" "$key")"
            printf '        %-14s %s\n' "${key}" "${spec_val}"
        done
    done

    _h "Conf values that feed those specs"
    if [[ -f "$conf" ]]; then
        grep -E '^MIRRORET_(APT|RPM)_(TARGETS|REPOS|ARCH|COMPONENTS|NEWEST_ONLY|SOURCE|DELETE|ENGINE|MIRROR_TOOL|SCHEME)|^MIRRORET_SYNC_' \
            "$conf" | sed 's/^/        /' || _in "        (none set - all defaults)"
    else
        _wa "${conf} does not exist; every setting is a built-in default"
    fi
    _in ""
    _in "If a spec disagrees with the conf, the conf was edited after the last"
    _in "upgrade. Apply it with: sudo mirroretctl upgrade"
    return "$rc"
}

# _conf_val <conf> <key> - value of a shell assignment in the conf file.
_conf_val() {
    local conf="$1" key="$2"
    [[ -f "$conf" ]] || { printf '%s' "${!key:-}"; return 0; }
    local v
    v="$(bash -c "set +u; source '${conf}' >/dev/null 2>&1; printf '%s' \"\${${key}:-}\"" 2>/dev/null)"
    printf '%s' "${v:-${!key:-}}"
}

# -------------------------------------------------------------------- menu ----

# _menu_run <cmd...> - run a menu action without letting a non-zero exit
# take the whole CLI down with it.
#
# The menu is a loop inside a function in a `set -e` script, so a bare
# `cmd_sync all` that returns 1 exits mirroretctl entirely. From the
# operator's side the menu simply disappears with no message - which is
# exactly what "pick sync while cron is syncing" looked like.
_menu_run() {
    local rc=0
    "$@" || rc=$?
    if [[ "$rc" -ne 0 ]]; then
        printf '\n'
        _wa "'$*' exited with status ${rc}."
        _in "Nothing else was changed. Returning to the menu."
    fi
    return 0
}

cmd_menu() {
    while true; do
        printf "\n${C_HEAD}mirroretctl${C_OFF}  base=%s\n" "${BASE_DIR}"
        cat <<'MENU'
   1) status            show services, ports, disk, last sync
   2) doctor            full read-only diagnostic
   3) sync all          run every sync now
   4) sync apt          Ubuntu / Debian only
   5) sync rpm          Oracle / Rocky / Alma / CentOS / EPEL only
   6) sync pip          PyPI packages only
   7) sync npm          npm packages only
   8) sync status       what is running / locks
   9) sync stop         stop running syncs
  10) clean report      retention dry run
  11) clean prune       retention delete
  12) serve             probe HTTP endpoints
  13) verify            check every published Release against files on disk
  14) cache status      on-demand cache daemon, hit rate, routes
  15) client list       generated client configs and their URLs
  16) client verify     check generated client configs
  17) client simulate   prove a client can install from this mirror
  18) approve list      packages staged and waiting for approval
  19) logs errors       failures in recent logs
  20) logs tail         follow newest sync log
  21) config show       active settings
  22) config diff       config vs what is actually generated
  23) config edit       edit config (then run upgrade)
  24) upgrade           re-apply config, regenerate scripts
  25) check             validate installation
  26) report            write one shareable txt report
  27) targets           what this server mirrors, and whether it synced
   q) quit
MENU
        printf "select> "
        local choice
        read -r choice || return 0
        # Every action runs through _menu_run. Without it, a subcommand that
        # returns non-zero kills the whole CLI via `set -e`, so the menu just
        # vanishes - which is what happened when a sync was picked while the
        # nightly cron run held the lock.
        case "$choice" in
            1) _menu_run cmd_status ;;
            2) _menu_run cmd_doctor ;;
            3) _menu_run cmd_sync all ;;
            4) _menu_run cmd_sync apt ;;
            5) _menu_run cmd_sync rpm ;;
            6) _menu_run cmd_sync pip ;;
            7) _menu_run cmd_sync npm ;;
            8) _menu_run cmd_sync_status ;;
            9) _menu_run cmd_sync_stop ;;
            10) _menu_run cmd_clean report ;;
            11) _menu_run cmd_clean prune ;;
            12) _menu_run cmd_serve ;;
            13) _menu_run cmd_verify ;;
            14) _menu_run cmd_cache status ;;
            15) _menu_run cmd_client list ;;
            16) _menu_run cmd_client verify ;;
            17) _menu_run cmd_client simulate ;;
            18) _menu_run cmd_approve list ;;
            19) _menu_run cmd_logs errors ;;
            20) _menu_run cmd_logs tail ;;
            21) _menu_run cmd_config show ;;
            22) _menu_run cmd_config diff ;;
            23) _menu_run cmd_config edit ;;
            24) _menu_run cmd_upgrade ;;
            25) _menu_run cmd_check ;;
            26) _menu_run cmd_collect ;;
            27) _menu_run cmd_targets list ;;
            q|Q|quit|exit) return 0 ;;
            "") ;;
            *)  _er "unknown selection: ${choice}" ;;
        esac
    done
}

