# ------------------------------------------------------------------ config ----

cmd_config() {
    local what="${1:-show}"
    local conf="${MIRRORET_CONF}"
    case "$what" in
        show)
            if [[ ! -f "$conf" ]]; then
                _wa "${conf} does not exist"
                _in "Create it: sudo cp ${SCRIPT_DIR}/config/mirroret.conf.example ${conf}"
                return 0
            fi
            _h "Active settings in ${conf}"
            grep -vE '^\s*(#|$)' "$conf" | sed 's/^/      /'
            ;;
        edit)
            _need_root config edit
            [[ -f "$conf" ]] || { mkdir -p /etc/mirroret; cp "${SCRIPT_DIR}/config/mirroret.conf.example" "$conf"; }
            "${EDITOR:-vi}" "$conf"
            _in "Apply with: sudo mirroretctl upgrade"
            ;;
        path)
            printf '%s\n' "$conf"
            ;;
        diff)
            # Show where what is RUNNING disagrees with what the conf asks
            # for. The generated target specs are the source of truth for
            # what actually syncs, so compare against those rather than
            # grepping one legacy script.
            _cli_config_diff "$conf"
            ;;
        *) _er "Usage: mirroretctl config {show|edit|path|diff}"; return 1 ;;
    esac
}

# _cli_config_diff <conf> - conf settings vs the live generated state.
_cli_config_diff() {
    local conf="$1"
    local rc=0

    _h "Targets: requested vs generated"
    local want_apt want_rpm
    want_apt="$(_conf_val "$conf" MIRRORET_APT_TARGETS)"
    want_rpm="$(_conf_val "$conf" MIRRORET_RPM_TARGETS)"
    _in "conf MIRRORET_APT_TARGETS = ${want_apt:-(unset - derived from this host)}"
    _in "conf MIRRORET_RPM_TARGETS = ${want_rpm:-(unset - derived from this host)}"

    local have_apt="" have_rpm="" spec
    for spec in "${TARGETS_DIR}"/apt-*.json; do
        [[ -f "$spec" ]] && have_apt+=" $(mirroret_json_field "$spec" id)"
    done
    for spec in "${TARGETS_DIR}"/rpm-*.json; do
        [[ -f "$spec" ]] && have_rpm+=" $(mirroret_json_field "$spec" id)"
    done
    _in "generated APT specs =${have_apt:- (none)}"
    _in "generated RPM specs =${have_rpm:- (none)}"

    # A target named in the conf with no spec means upgrade was never run.
    local t flavor release want_id missing=""
    for t in ${want_apt}; do
        flavor="${t%%:*}"; release="${t#*:}"; release="${release%%:*}"
        [[ "$flavor" == "$t" ]] && continue
        if [[ " ${have_apt} " != *"${flavor%%-*}"* ]] && \
           [[ " ${have_apt} " != *"${flavor}"* ]]; then
            missing+=" ${t}"
        fi
    done
    for t in ${want_rpm}; do
        flavor="${t%%:*}"; release="${t#*:}"; release="${release%%:*}"
        [[ "$flavor" == "$t" ]] && continue
        want_id="${flavor}${release}"
        [[ " ${have_rpm} " == *" ${want_id} "* ]] || missing+=" ${t}"
    done
    if [[ -n "${missing}" ]]; then
        _er "requested but NOT generated:${missing}"
        _in "  Run: sudo mirroretctl upgrade"
        rc=1
    else
        _ok "every requested target has a generated spec"
    fi

    _h "Sync scripts present"
    local sc found=0 notexec=""
    for sc in sync-apt-repos.sh sync-rpm-repos.sh sync-apt-debmirror.sh \
              sync-redhat-repos.sh sync-pip-packages.sh sync-npm-packages.sh \
              sync-docker-images.sh sync-all.sh; do
        [[ -f "${SCRIPTS_DIR}/${sc}" ]] || continue
        found=1
        # Present but not executable is its own failure, and a common one:
        # a zip transfer does not preserve the execute bit, so the scripts
        # are all there and cron silently runs none of them.
        if [[ -x "${SCRIPTS_DIR}/${sc}" ]]; then
            _in "${sc}"
        else
            _in "${sc}  (NOT EXECUTABLE)"
            notexec+=" ${sc}"
        fi
    done
    if [[ "$found" -eq 0 ]]; then
        _er "no generated sync scripts at all"
        _in "  Run: sudo mirroretctl upgrade"
        rc=1
    fi
    if [[ -n "${notexec}" ]]; then
        _er "present but not executable:${notexec}"
        _in "  cron runs none of these. A zip transfer drops the execute bit."
        _in "  Fix: sudo chmod +x ${SCRIPTS_DIR}/*.sh"
        rc=1
    fi

    # An APT/RPM target with no matching sync script cannot ever run.
    if [[ -n "${have_apt}" ]] && [[ ! -f "${SCRIPTS_DIR}/sync-apt-repos.sh" ]] \
       && [[ ! -f "${SCRIPTS_DIR}/sync-apt-debmirror.sh" ]]; then
        _er "APT targets exist but there is no APT sync script"
        _in "  Run: sudo mirroretctl upgrade"
        rc=1
    fi
    if [[ -n "${have_rpm}" ]] && [[ ! -f "${SCRIPTS_DIR}/sync-rpm-repos.sh" ]] \
       && [[ ! -f "${SCRIPTS_DIR}/sync-redhat-repos.sh" ]]; then
        _er "RPM targets exist but there is no RPM sync script"
        _in "  Run: sudo mirroretctl upgrade"
        rc=1
    fi

    _h "Sync knobs: conf vs generated specs"
    local key spec_val
    for spec in "${TARGETS_DIR}"/rpm-*.json; do
        [[ -f "$spec" ]] || continue
        _in "$(basename "$spec"):"
        for key in arches newest_only sources delete min_free_gb; do
            spec_val="$(mirroret_json_field "$spec" "$key")"
            printf '        %-14s %s\n' "${key}" "${spec_val}"
        done
    done
    for spec in "${TARGETS_DIR}"/apt-*.json; do
        [[ -f "$spec" ]] || continue
        _in "$(basename "$spec"):"
        for key in arches components sources delete min_free_gb; do
            spec_val="$(mirroret_json_field "$spec" "$key")"
            printf '        %-14s %s\n' "${key}" "${spec_val}"
        done
    done

    _h "Conf values that feed those specs"
    if [[ -f "$conf" ]]; then
        grep -E '^MIRRORET_(APT|RPM)_(TARGETS|REPOS|ARCH|COMPONENTS|NEWEST_ONLY|SOURCE|DELETE|ENGINE|MIRROR_TOOL|SCHEME)|^MIRRORET_SYNC_' \
            "$conf" | sed 's/^/        /' || _in "        (none set - all defaults)"
    else
        _wa "${conf} does not exist; every setting is a built-in default"
    fi
    _in ""
    _in "If a spec disagrees with the conf, the conf was edited after the last"
    _in "upgrade. Apply it with: sudo mirroretctl upgrade"
    return "$rc"
}

# _conf_val <conf> <key> - value of a shell assignment in the conf file.
_conf_val() {
    local conf="$1" key="$2"
    [[ -f "$conf" ]] || { printf '%s' "${!key:-}"; return 0; }
    local v
    v="$(bash -c "set +u; source '${conf}' >/dev/null 2>&1; printf '%s' \"\${${key}:-}\"" 2>/dev/null)"
    printf '%s' "${v:-${!key:-}}"
}

