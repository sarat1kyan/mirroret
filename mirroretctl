#!/usr/bin/env bash
# mirroretctl - single control surface for a mirroret server.
#
# Wraps install/uninstall/sync/retention/service/client operations behind
# one verb-noun CLI so operators do not have to remember which script under
# /srv/mirroret/scripts/ does what.
#
# Run with no arguments for an interactive menu, or pass a subcommand.
#
# Read-only subcommands work without root. Anything that changes state
# requires root and says so.

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/logging.sh
source "${SCRIPT_DIR}/lib/logging.sh"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/distro.sh
source "${SCRIPT_DIR}/lib/distro.sh"
# shellcheck source=lib/approval.sh
source "${SCRIPT_DIR}/lib/approval.sh"

# Load operator config so paths/ports match the running install.
# MIRRORET_CONF lets you point at a different file - useful for inspecting a
# staged config before applying it, and it is what makes `config diff`
# testable.
MIRRORET_CONF="${MIRRORET_CONF:-/etc/mirroret/mirroret.conf}"
if [[ -f "${MIRRORET_CONF}" ]]; then
    # shellcheck disable=SC1090,SC1091
    . "${MIRRORET_CONF}"
fi

BASE_DIR="${MIRRORET_BASE_DIR:-/srv/mirroret}"
SCRIPTS_DIR="${BASE_DIR}/scripts"
LOGS_DIR="${BASE_DIR}/logs"
CONFIG_DIR="${BASE_DIR}/config"
WEB_PORT="${MIRRORET_WEB_PORT:-8080}"
PIP_PORT="${MIRRORET_PIP_PORT:-8081}"
NPM_PORT="${MIRRORET_NPM_PORT:-4873}"
REG_PORT="${MIRRORET_DOCKER_REGISTRY_PORT:-5000}"

MIRRORET_SERVICES=(nginx pypiserver verdaccio)

# Colors only on a TTY.
if [[ -t 1 ]]; then
    C_OK="\033[32m"; C_WARN="\033[33m"; C_ERR="\033[31m"
    C_HEAD="\033[36m"; C_OFF="\033[0m"
else
    C_OK=""; C_WARN=""; C_ERR=""; C_HEAD=""; C_OFF=""
fi

_h()  { printf "\n${C_HEAD}== %s ==${C_OFF}\n" "$*"; }
_ok() { printf "${C_OK}ok${C_OFF}    %s\n" "$*"; }
_wa() { printf "${C_WARN}warn${C_OFF}  %s\n" "$*"; }
_er() { printf "${C_ERR}fail${C_OFF}  %s\n" "$*"; }
_in() { printf "      %s\n" "$*"; }

_need_root() {
    if [[ "$(id -u)" -ne 0 ]]; then
        _er "This subcommand changes state and needs root."
        _in "Re-run: sudo $0 $*"
        exit 1
    fi
}

_have_install_tree() {
    [[ -f "${SCRIPT_DIR}/install.sh" ]]
}

# _run_script <path> [args...] - run a generated script if it exists.
_run_script() {
    local s="$1"; shift || true
    if [[ ! -x "$s" ]]; then
        _er "Not found or not executable: $s"
        _in "Run 'mirroretctl install' (or install.sh --upgrade) to regenerate it."
        return 1
    fi
    "$s" "$@"
}

# ---------------------------------------------------------------- status ----

cmd_status() {
    _h "Mirroret status"
    printf "Base dir : %s\n" "${BASE_DIR}"
    printf "Host     : %s\n" "$(hostname 2>/dev/null || echo unknown)"

    _h "Services"
    if ! check_command systemctl; then
        _wa "systemctl not available"
    else
        local svc state
        for svc in "${MIRRORET_SERVICES[@]}"; do
            systemctl list-unit-files --full --no-legend "${svc}.service" 2>/dev/null \
                | grep -q "${svc}.service" || continue
            state="$(systemctl is-active "$svc" 2>/dev/null || true)"
            case "$state" in
                active)   _ok "${svc}: active" ;;
                inactive) _in "${svc}: inactive" ;;
                failed)   _er "${svc}: failed"
                          _in "  journalctl -u ${svc} -n 50 --no-pager" ;;
                activating)
                          _er "${svc}: ${state} (restart loop)"
                          _cli_diagnose_execstart "$svc" ;;
                *)        _in "${svc}: ${state:-unknown}" ;;
            esac
        done
        # Registry can be native or a podman-managed unit.
        for svc in docker-distribution docker-registry mirroret-registry; do
            systemctl list-unit-files --full --no-legend "${svc}.service" 2>/dev/null \
                | grep -q "${svc}.service" || continue
            state="$(systemctl is-active "$svc" 2>/dev/null || true)"
            if [[ "$state" == "active" ]]; then
                _ok "${svc}: active"
            else
                _er "${svc}: ${state:-unknown}"
            fi
        done
    fi

    _h "Ports"
    local p
    for p in "${WEB_PORT}" "${PIP_PORT}" "${NPM_PORT}" "${REG_PORT}"; do
        if check_command ss && ss -H -lnt "sport = :${p}" 2>/dev/null | grep -q LISTEN; then
            _ok "${p} listening"
        else
            _in "${p} free"
        fi
    done

    _h "Disk"
    if [[ -d "${BASE_DIR}" ]]; then
        df -h "${BASE_DIR}" | tail -1 | awk '{printf "      %s used of %s (%s), %s free\n",$3,$2,$5,$4}'
        du -sh "${BASE_DIR}"/* 2>/dev/null | sed 's/^/      /' || true
    else
        _wa "${BASE_DIR} does not exist. Not installed yet?"
    fi

    _h "Last sync"
    cmd_sync_last

    _h "Cron"
    if check_command crontab; then
        local block
        block="$(crontab -l 2>/dev/null | awk '/>>> mirroret managed/{f=1;next}/<<< mirroret managed/{f=0}f' || true)"
        if [[ -n "$block" ]]; then
            printf '%s\n' "$block" | sed 's/^/      /'
        else
            _wa "no mirroret cron block"
        fi
    else
        _wa "crontab not installed"
    fi
}

_cli_diagnose_execstart() {
    local svc="$1" exec_path
    exec_path="$(systemctl show -p ExecStart --value "$svc" 2>/dev/null \
        | sed -n 's/.*path=\([^ ;]*\).*/\1/p' | head -1)"
    [[ -z "$exec_path" ]] && return 0
    if [[ ! -x "$exec_path" ]]; then
        _in "  ExecStart missing: ${exec_path}"
        _in "  systemd reports 203/EXEC. Fix the path, then:"
        _in "    sudo ${SCRIPT_DIR}/install.sh --upgrade"
    fi
}

# ------------------------------------------------------------------ sync ----

cmd_sync() {
    local target="${1:-all}"
    _need_root sync "$target"
    case "$target" in
        all)    _run_script "${SCRIPTS_DIR}/sync-all.sh" ;;
        pip)    _run_script "${SCRIPTS_DIR}/sync-pip-packages.sh" ;;
        npm)    _run_script "${SCRIPTS_DIR}/sync-npm-packages.sh" ;;
        docker) _run_script "${SCRIPTS_DIR}/sync-docker-images.sh" ;;
        rpm|redhat)
            # Native engine first; fall back to the reposync-based script for
            # installs that pinned MIRRORET_RPM_ENGINE=reposync.
            if [[ -x "${SCRIPTS_DIR}/sync-rpm-repos.sh" ]]; then
                _run_script "${SCRIPTS_DIR}/sync-rpm-repos.sh"
            elif [[ -x "${SCRIPTS_DIR}/sync-redhat-repos.sh" ]]; then
                _run_script "${SCRIPTS_DIR}/sync-redhat-repos.sh"
            else
                _er "No RPM sync script found in ${SCRIPTS_DIR}."
                _in "Set MIRRORET_RPM_TARGETS (e.g. \"ol:9 rocky:9\") and run:"
                _in "  sudo mirroretctl upgrade"
                return 1
            fi
            ;;
        apt|debian|ubuntu)
            if [[ -x "${SCRIPTS_DIR}/sync-apt-repos.sh" ]]; then
                _run_script "${SCRIPTS_DIR}/sync-apt-repos.sh"
            elif [[ -x "${SCRIPTS_DIR}/sync-apt-debmirror.sh" ]]; then
                _run_script "${SCRIPTS_DIR}/sync-apt-debmirror.sh"
            else
                _er "No APT sync script found in ${SCRIPTS_DIR}."
                _in "APT mirroring works on ANY host, but it needs targets:"
                _in "  MIRRORET_APT_TARGETS=\"ubuntu:jammy debian:bookworm\""
                _in "in /etc/mirroret/mirroret.conf, then: sudo mirroretctl upgrade"
                return 1
            fi
            ;;
        *) _er "Unknown sync target: ${target}"
           _in "Valid: all apt rpm pip npm docker"
           return 1 ;;
    esac
}

cmd_sync_status() {
    _h "Sync locks"
    local lk lf
    for lk in apt redhat pip npm; do
        lf="/var/lock/mirroret-sync-${lk}.lock"
        if [[ ! -e "$lf" ]]; then
            _in "${lk}: idle (no lock file)"
            continue
        fi
        # flock -n succeeds only when nothing holds the lock.
        if flock -n "$lf" true 2>/dev/null; then
            _in "${lk}: idle"
        else
            _ok "${lk}: RUNNING"
        fi
    done

    _h "Running sync processes"
    local found=0
    local pat
    for pat in mirroret_apt.py mirroret_rpm.py reposync debmirror 'sync-all.sh' \
               'sync-apt' 'sync-redhat' 'sync-rpm' 'sync-pip' 'sync-npm' 'sync-docker'; do
        if pgrep -af "$pat" 2>/dev/null | grep -v mirroretctl | sed 's/^/      /'; then
            found=1
        fi
    done
    # Must not be a trailing '&&': when found=1 the test is false and the
    # function would return 1, i.e. "sync status" would fail exactly when a
    # sync is running.
    if [[ "$found" -eq 0 ]]; then
        _in "none"
    fi
    return 0
}

cmd_sync_last() {
    if [[ ! -d "${LOGS_DIR}" ]]; then
        _in "no logs yet"
        return 0
    fi
    local f
    # Newest 5 sync logs, with their final line (which carries the counts).
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        printf "      %-38s %s\n" "$(basename "$f")" "$(tail -1 "$f" 2>/dev/null | cut -c1-70)"
    done < <(ls -1t "${LOGS_DIR}"/sync-*.log 2>/dev/null | head -5)
}

cmd_sync_stop() {
    _need_root sync-stop
    _h "Stopping sync processes"
    local pat killed=0
    for pat in mirroret_apt.py mirroret_rpm.py reposync debmirror 'sync-all.sh' \
               'sync-apt-repos' 'sync-apt-debmirror' 'sync-redhat-repos' 'sync-rpm-repos' \
               'sync-pip-packages' 'sync-npm-packages' 'sync-docker-images'; do
        if pkill -f "$pat" 2>/dev/null; then
            _ok "signalled: ${pat}"
            killed=1
        fi
    done
    [[ "$killed" -eq 0 ]] && _in "nothing running"
    _in "Locks release automatically when the holding process exits."
}

# ------------------------------------------------------------- retention ----

cmd_clean() {
    local mode="${1:-report}"
    _need_root clean "$mode"
    case "$mode" in
        report) _run_script_or_install --cleanup-report ;;
        prune)  _run_script_or_install --cleanup ;;
        *) _er "Unknown clean mode: ${mode}"
           _in "Valid: report (dry run, default) | prune (delete)"
           return 1 ;;
    esac
}

_run_script_or_install() {
    if _have_install_tree; then
        "${SCRIPT_DIR}/install.sh" "$@"
    else
        _er "install.sh not found next to mirroretctl."
        return 1
    fi
}

# ---------------------------------------------------------------- targets ----

TARGETS_DIR="${MIRRORET_TARGETS_DIR:-/etc/mirroret/targets}"

# cmd_targets - what this server mirrors, and whether it has actually synced.
#
# The single most confusing thing about the old tool was that a RHEL server
# silently mirrored no Ubuntu at all. This makes the answer to "what does
# this box serve?" a one-line command.
cmd_targets() {
    local what="${1:-list}"
    case "$what" in
        list|status)
            _h "Configured mirror targets"
            if [[ ! -d "${TARGETS_DIR}" ]]; then
                _wa "${TARGETS_DIR} does not exist - nothing is configured."
                _in "Set MIRRORET_APT_TARGETS / MIRRORET_RPM_TARGETS in"
                _in "/etc/mirroret/mirroret.conf, then: sudo mirroretctl upgrade"
                return 0
            fi
            local found=0 spec
            for spec in "${TARGETS_DIR}"/apt-*.json; do
                [[ -f "$spec" ]] || continue
                found=1
                _targets_report_apt "$spec"
            done
            for spec in "${TARGETS_DIR}"/rpm-*.json; do
                [[ -f "$spec" ]] || continue
                found=1
                _targets_report_rpm "$spec"
            done
            if [[ "$found" -eq 0 ]]; then
                _wa "No target specs in ${TARGETS_DIR}."
                _in "APT example: MIRRORET_APT_TARGETS=\"ubuntu:jammy debian:bookworm\""
                _in "RPM example: MIRRORET_RPM_TARGETS=\"ol:9 rocky:9 epel:9\""
            fi
            ;;
        show)
            local spec="${TARGETS_DIR}/${2:-}"
            [[ -f "$spec" ]] || { _er "No such target spec: ${spec}"; return 1; }
            cat "$spec"
            ;;
        *)
            _er "Usage: mirroretctl targets {list|show <file>}"
            return 1 ;;
    esac
}

_targets_report_apt() {
    local spec="$1"
    local id dir suites comps arches dest
    id="$(mirroret_json_field "$spec" id)"
    dir="$(mirroret_json_field "$spec" dir)"
    dest="$(mirroret_json_field "$spec" dest)"
    suites="$(mirroret_json_field "$spec" suites)"
    comps="$(mirroret_json_field "$spec" components)"
    arches="$(mirroret_json_field "$spec" arches)"

    printf "\n  APT  %s\n" "${id}"
    _in "url        http://$(_ctl_ip):${WEB_PORT}/${dir}"
    _in "suites     ${suites}"
    _in "components ${comps}"
    _in "arches     ${arches}"

    local suite ok=0 missing=""
    for suite in ${suites}; do
        if [[ -f "${dest}/dists/${suite}/Release" ]] || \
           [[ -f "${dest}/dists/${suite}/InRelease" ]]; then
            ok=$(( ok + 1 ))
        else
            missing+=" ${suite}"
        fi
    done
    local debs=0
    [[ -d "${dest}/pool" ]] && debs="$(find "${dest}/pool" -name '*.deb' 2>/dev/null | wc -l | tr -d ' ')"
    if [[ -n "${missing}" ]]; then
        _wa "not synced yet:${missing}"
        _in "run: sudo mirroretctl sync apt"
    else
        _ok "${ok}/${ok} suites published, ${debs} .deb on disk"
    fi
}

_targets_report_rpm() {
    local spec="$1"
    local id flavor major repos arches dest
    id="$(mirroret_json_field "$spec" id)"
    flavor="$(mirroret_json_field "$spec" flavor)"
    major="$(mirroret_json_field "$spec" version)"
    dest="$(mirroret_json_field "$spec" dest)"
    repos="$(mirroret_json_field "$spec" repos)"
    arches="$(mirroret_json_field "$spec" arches)"

    printf "\n  RPM  %s\n" "${id}"
    _in "url        http://$(_ctl_ip):${WEB_PORT}/redhat/${flavor}/${major}/<repo>"
    _in "repos      ${repos}"
    _in "arches     ${arches}"

    local repo published=0 total=0 rpms=0 missing=""
    for repo in ${repos}; do
        total=$(( total + 1 ))
        if [[ -f "${dest}/${repo}/repodata/repomd.xml" ]]; then
            published=$(( published + 1 ))
            rpms=$(( rpms + $(find "${dest}/${repo}" -name '*.rpm' 2>/dev/null | wc -l) ))
        else
            missing+=" ${repo}"
        fi
    done
    if [[ -n "${missing}" ]]; then
        _wa "not synced yet:${missing}"
        _in "run: sudo mirroretctl sync rpm"
    else
        _ok "${published}/${total} repos published, ${rpms} rpm on disk"
    fi
}

_ctl_ip() {
    printf '%s' "${MIRRORET_SERVER_IP:-$(get_server_ip 2>/dev/null || echo '<server-ip>')}"
}

# --------------------------------------------------------------- install ----

cmd_install() {
    _need_root install "$@"
    _run_script_or_install "$@"
}

cmd_upgrade() {
    _need_root upgrade
    _run_script_or_install --upgrade
}

cmd_check() {
    _need_root check
    _run_script_or_install --check
}

cmd_uninstall() {
    _need_root uninstall "$@"
    if [[ ! -x "${SCRIPT_DIR}/uninstall.sh" ]]; then
        _er "uninstall.sh not found next to mirroretctl."
        return 1
    fi
    "${SCRIPT_DIR}/uninstall.sh" "$@"
}

# --------------------------------------------------------------- service ----

cmd_service() {
    local action="${1:-}" svc="${2:-}"
    case "$action" in
        list)
            _h "Mirroret units"
            local s state
            for s in "${MIRRORET_SERVICES[@]}" docker-distribution docker-registry mirroret-registry; do
                systemctl list-unit-files --full --no-legend "${s}.service" 2>/dev/null \
                    | grep -q "${s}.service" || continue
                state="$(systemctl is-active "$s" 2>/dev/null || true)"
                printf "      %-22s %s\n" "$s" "${state:-unknown}"
            done
            ;;
        restart|start|stop)
            _need_root service "$action" "$svc"
            [[ -z "$svc" ]] && { _er "Usage: mirroretctl service ${action} <unit>"; return 1; }
            systemctl "$action" "$svc" && _ok "${action} ${svc}" || { _er "${action} ${svc} failed"; return 1; }
            ;;
        logs)
            [[ -z "$svc" ]] && { _er "Usage: mirroretctl service logs <unit>"; return 1; }
            journalctl -u "$svc" -n "${3:-100}" --no-pager
            ;;
        *)
            _er "Usage: mirroretctl service {list|start|stop|restart|logs} [unit]"
            return 1 ;;
    esac
}

# ---------------------------------------------------------------- client ----

# cmd_client_simulate [pkg...] - behave like a real client against this mirror.
#
# Everything else in this tool inspects the server. This asks the only
# question that matters: can a client resolve and download a package? It
# queries the mirror over HTTP using the generated client config, so it
# exercises the same path a client host does: nginx, the URL mapping, and
# whether the metadata lists packages that actually exist on disk.
cmd_client_simulate() {
    local ip="${MIRRORET_SERVER_IP:-$(get_server_ip 2>/dev/null || echo 127.0.0.1)}"
    local repofile="${CONFIG_DIR}/redhat-client.repo"
    local rc=0

    if ! check_command dnf; then
        _wa "dnf not available; cannot simulate an RPM client here."
        return 0
    fi
    if [[ ! -f "$repofile" ]]; then
        _er "No generated client config at ${repofile}"
        _in "Run: sudo ${SCRIPT_DIR}/install.sh --upgrade"
        return 1
    fi

    # Default probes cover the case that keeps biting: 32-bit multilib.
    local -a pkgs=("$@")
    if [[ "${#pkgs[@]}" -eq 0 ]]; then
        pkgs=(bash glibc glibc.i686 libstdc++.i686 kernel)
    fi

    _h "Client simulation against ${ip}:${WEB_PORT}"

    # Build a throwaway dnf config from the generated client repo file so the
    # host's own repos cannot satisfy the query and mask a broken mirror.
    local tmpd cache
    tmpd="$(mktemp -d)" || return 1
    cache="${tmpd}/cache"
    mkdir -p "$cache"
    # gpgcheck off for the QUERY only: we are testing reachability and
    # metadata correctness here, not signatures.
    sed 's/^gpgcheck=1/gpgcheck=0/; /^gpgkey=/d' "$repofile" > "${tmpd}/mirror.repo"

    local -a repoids=()
    local id
    while IFS= read -r id; do repoids+=("$id"); done < <(
        grep -oE '^\[[^]]+\]' "${tmpd}/mirror.repo" | tr -d '[]')
    if [[ "${#repoids[@]}" -eq 0 ]]; then
        _er "No repo stanzas found in ${repofile}"
        rm -rf "$tmpd"; return 1
    fi
    _in "repos: ${repoids[*]}"

    local -a dnfargs=(--quiet --disablerepo='*'
                      --setopt=reposdir="${tmpd}"
                      --setopt=cachedir="${cache}"
                      --setopt=gpgcheck=0)
    for id in "${repoids[@]}"; do dnfargs+=(--enablerepo="$id"); done

    _h "Metadata reachable over HTTP"
    if dnf "${dnfargs[@]}" repoquery --qf '%{name}' bash >/dev/null 2>&1; then
        _ok "all repos parsed their metadata through nginx"
    else
        _er "could not load repo metadata from the mirror"
        _in "Detail:"
        dnf "${dnfargs[@]}" repoquery --qf '%{name}' bash 2>&1 | tail -n 12 | sed 's/^/      /'
        rm -rf "$tmpd"
        return 1
    fi

    _h "Package resolution"
    local pkg out loc code
    for pkg in "${pkgs[@]}"; do
        out="$(dnf "${dnfargs[@]}" repoquery --qf '%{name}-%{version}-%{release}.%{arch}' \
               "$pkg" 2>/dev/null | head -1)"
        if [[ -z "$out" ]]; then
            _er "${pkg}: NOT FOUND in the mirror metadata"
            case "$pkg" in
                *.i686)
                    _in "  i686 packages are missing from the metadata."
                    _in "  Set MIRRORET_RPM_ARCH=\"x86_64 i686\" in /etc/mirroret/mirroret.conf,"
                    _in "  then: sudo ${SCRIPTS_DIR}/sync-redhat-repos.sh" ;;
            esac
            rc=1
            continue
        fi

        # Metadata listing a package proves nothing if the file is absent.
        # This is exactly what a filtered mirror with upstream metadata does.
        loc="$(dnf "${dnfargs[@]}" repoquery --location "$pkg" 2>/dev/null | head -1)"
        if [[ -z "$loc" ]]; then
            _wa "${pkg}: ${out} listed, but no download location resolved"
            rc=1
            continue
        fi
        code="$(curl -sS -o /dev/null -m 20 -w '%{http_code}' "$loc" 2>/dev/null)"
        if [[ "$code" == "200" ]]; then
            _ok "${pkg}: ${out} (downloadable)"
        else
            _er "${pkg}: ${out} is listed in metadata but returns HTTP ${code}"
            _in "  ${loc}"
            _in "  Metadata does not match what is on disk. Rebuild it:"
            _in "    sudo ${SCRIPTS_DIR}/sync-redhat-repos.sh"
            rc=1
        fi
    done

    rm -rf "$tmpd"
    _h "Result"
    if [[ "$rc" -eq 0 ]]; then
        _ok "a client host can resolve AND download every probed package"
    else
        _er "at least one package a client would ask for is not usable"
    fi
    return "$rc"
}

cmd_client() {
    local what="${1:-list}"
    case "$what" in
        simulate|test)
            shift || true
            cmd_client_simulate "$@"
            ;;
        list)
            _h "Generated client configs"
            if [[ ! -d "${CONFIG_DIR}" ]]; then
                _wa "${CONFIG_DIR} does not exist"
                return 0
            fi
            ls -1 "${CONFIG_DIR}" 2>/dev/null | sed 's/^/      /'
            _h "Serve URLs"
            local ip
            ip="$(_ctl_ip)"
            local f
            # One config per mirrored target, so list what is really there
            # rather than two hardcoded legacy names.
            for f in "${CONFIG_DIR}"/*.list "${CONFIG_DIR}"/*.sources \
                     "${CONFIG_DIR}"/*.repo "${CONFIG_DIR}"/pip.conf \
                     "${CONFIG_DIR}"/.npmrc "${CONFIG_DIR}"/docker-daemon.json; do
                [[ -e "$f" ]] || continue
                _in "http://${ip}:${WEB_PORT}/config/$(basename "$f")"
            done
            ;;
        show)
            local f="${2:-}"
            [[ -z "$f" ]] && { _er "Usage: mirroretctl client show <filename>"; return 1; }
            if [[ ! -f "${CONFIG_DIR}/${f}" ]]; then
                _er "No such client config: ${CONFIG_DIR}/${f}"
                return 1
            fi
            cat "${CONFIG_DIR}/${f}"
            ;;
        verify)
            _cli_verify_client_configs
            ;;
        *)
            _er "Usage: mirroretctl client {list|show <file>|verify}"
            return 1 ;;
    esac
}

# _cli_verify_client_configs - catch the mistakes that break real clients.
_cli_verify_client_configs() {
    local rc=0
    _h "Client config sanity"

    local repo="${CONFIG_DIR}/redhat-client.repo"
    if [[ -f "$repo" ]]; then
        if grep -q '^gpgcheck=1' "$repo" && ! grep -qE '^gpgkey=' "$repo"; then
            _er "redhat-client.repo: gpgcheck=1 with no gpgkey. Every client dnf call will fail."
            _in "  Set MIRRORET_RPM_GPGKEY_URL or re-run install.sh --upgrade."
            rc=1
        else
            _ok "redhat-client.repo: gpgcheck/gpgkey consistent"
        fi
    else
        _in "redhat-client.repo: not generated (no RPM target configured)"
    fi

    # Every generated .repo file, checked for actually-published metadata.
    local rf
    for rf in "${CONFIG_DIR}"/*.repo; do
        [[ -f "$rf" ]] || continue
        _cli_verify_rpm_repos "$rf" || rc=1
    done

    # Every generated APT sources file, not just the legacy single name.
    local list base
    for list in "${CONFIG_DIR}"/*.list; do
        [[ -f "$list" ]] || continue
        base="$(basename "$list")"
        if grep -q 'signed-by=.*mirroret.gpg' "$list" && \
           [[ "${MIRRORET_APT_RESIGN:-0}" != "1" ]]; then
            _er "${base}: signed-by points at mirroret.gpg but MIRRORET_APT_RESIGN is not 1."
            _in "  Mirrored Release files carry the UPSTREAM signature. apt update will fail."
            rc=1
        else
            _ok "${base}: signed-by configuration consistent"
        fi
        # Every suite the file advertises must actually be published, or the
        # client gets "Failed to fetch ... Packages 404" on apt update. A
        # suite is published when its Release file is on disk; the engine
        # writes that last, only after the suite is complete.
        _cli_verify_apt_suites "$list" || rc=1
    done

    local dj="${CONFIG_DIR}/docker-daemon.json"
    if [[ -f "$dj" ]]; then
        if check_command python3 && ! python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$dj" 2>/dev/null; then
            _er "docker-daemon.json: not valid JSON"
            rc=1
        else
            _ok "docker-daemon.json: valid JSON"
        fi
        if [[ "${MIRRORET_DOCKER_MODE:-cache}" == "hosted" ]] && grep -q 'registry-mirrors' "$dj"; then
            _wa "docker-daemon.json: registry-mirrors set but mode is hosted. Clients should pull explicitly."
        fi
    fi

    return "$rc"
}

# _cli_verify_apt_suites <sources-file> - are all its suites published?
_cli_verify_apt_suites() {
    local list="$1" base
    base="$(basename "$list")"
    local rc=0 missing="" present=0
    local url suite prefix dir
    # Lines look like: deb [opts] http://ip:port/<prefix> <suite> <components>
    while read -r url suite; do
        [[ -z "$url" || -z "$suite" ]] && continue
        prefix="${url##*/}"
        dir="${BASE_DIR}/apt/${prefix}/dists/${suite}"
        if [[ -f "${dir}/Release" ]] || [[ -f "${dir}/InRelease" ]]; then
            present=$(( present + 1 ))
        else
            missing+=" ${suite}"
        fi
    done < <(awk '$1=="deb" {
                      for (i=2; i<=NF; i++) {
                          if ($i ~ /^http/) { print $i, $(i+1); break }
                      }
                  }' "$list")

    if [[ -n "${missing}" ]]; then
        _wa "${base}: advertises suite(s) that are not published yet:${missing}"
        _in "  Clients will report 'Failed to fetch ... Packages 404' for those."
        _in "  Run: sudo mirroretctl sync apt"
        _in "  If a suite genuinely does not exist upstream, remove it from"
        _in "  MIRRORET_APT_TARGETS and re-run: sudo mirroretctl upgrade"
        rc=1
    elif [[ "${present}" -gt 0 ]]; then
        _ok "${base}: all ${present} advertised suite(s) are published"
    fi
    return "$rc"
}

# _cli_verify_rpm_repos <repo-file> - are all its baseurls published?
_cli_verify_rpm_repos() {
    local repo="$1" base
    base="$(basename "$repo")"
    local rc=0 missing="" present=0 url path
    while IFS= read -r url; do
        [[ -z "$url" ]] && continue
        # baseurl is http://ip:port/redhat/<flavor>/<major>/<repo>; on disk
        # that lives at <base>/redhat/mirror/<flavor>/<major>/<repo>.
        path="${BASE_DIR}/redhat/mirror/${url##*/redhat/}"
        if [[ -f "${path}/repodata/repomd.xml" ]]; then
            present=$(( present + 1 ))
        else
            missing+=" ${url##*/}"
        fi
    done < <(grep -E '^baseurl=' "$repo" | sed 's/^baseurl=//')

    if [[ -n "${missing}" ]]; then
        _wa "${base}: repo(s) with no published metadata yet:${missing}"
        _in "  Clients will report 'Cannot download repomd.xml' for those."
        _in "  Run: sudo mirroretctl sync rpm"
        rc=1
    elif [[ "${present}" -gt 0 ]]; then
        _ok "${base}: all ${present} repo(s) have published metadata"
    fi
    return "$rc"
}

# ------------------------------------------------------------------ serve ----

# cmd_serve - prove the mirror answers over HTTP the way a client will see it.
cmd_serve() {
    _h "Endpoint reachability (localhost)"
    if ! check_command curl; then
        _wa "curl not installed; skipping"
        return 0
    fi
    local rc=0
    _cli_probe "nginx  /"          "http://127.0.0.1:${WEB_PORT}/"            || rc=1
    _cli_probe "nginx  /config/"   "http://127.0.0.1:${WEB_PORT}/config/"     || rc=1
    _cli_probe "pip    /simple/"   "http://127.0.0.1:${PIP_PORT}/simple/"     || rc=1
    _cli_probe "npm    /"          "http://127.0.0.1:${NPM_PORT}/"            || rc=1
    _cli_probe "docker /v2/"       "http://127.0.0.1:${REG_PORT}/v2/"         || rc=1

    _h "Blocked paths (must NOT be served)"
    local code
    for p in logs scripts; do
        code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 \
            "http://127.0.0.1:${WEB_PORT}/${p}/" 2>/dev/null || echo 000)"
        if [[ "$code" == "403" || "$code" == "404" ]]; then
            _ok "/${p}/ blocked (HTTP ${code})"
        else
            _er "/${p}/ is reachable (HTTP ${code}). It should be denied."
            rc=1
        fi
    done
    return "$rc"
}

_cli_probe() {
    local label="$1" url="$2" code
    code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 "$url" 2>/dev/null || echo 000)"
    case "$code" in
        000) _er "${label}: no response (${url})"; return 1 ;;
        200|301|302|401|403) _ok "${label}: HTTP ${code}" ;;
        *)   _wa "${label}: HTTP ${code}" ;;
    esac
    return 0
}

# ------------------------------------------------------------------- logs ----

cmd_logs() {
    local what="${1:-list}"
    case "$what" in
        list)
            _h "Sync logs (newest first)"
            [[ -d "${LOGS_DIR}" ]] || { _wa "no log dir"; return 0; }
            ls -1lht "${LOGS_DIR}" 2>/dev/null | head -20 | sed 's/^/      /'
            _h "Disk used by logs"
            du -sh "${LOGS_DIR}" 2>/dev/null | sed 's/^/      /' || true
            ;;
        tail)
            local f
            f="$(ls -1t "${LOGS_DIR}"/sync-*.log 2>/dev/null | head -1 || true)"
            [[ -z "$f" ]] && { _wa "no sync logs"; return 0; }
            _in "tailing: $f"
            tail -f "$f"
            ;;
        show)
            local f
            f="$(ls -1t "${LOGS_DIR}"/sync-*.log 2>/dev/null | head -1 || true)"
            [[ -z "$f" ]] && { _wa "no sync logs"; return 0; }
            "${PAGER:-less}" "$f"
            ;;
        errors)
            _h "Failures in the most recent logs"
            [[ -d "${LOGS_DIR}" ]] || { _wa "no log dir"; return 0; }
            local f
            while IFS= read -r f; do
                [[ -z "$f" ]] && continue
                if grep -nE '^(FAIL|ERROR|ABORT)|FAILED:|PULL FAILED|PUBLISH FAILED' "$f" >/dev/null 2>&1; then
                    printf "\n      %s\n" "$(basename "$f")"
                    grep -nE '^(FAIL|ERROR|ABORT)|FAILED:|PULL FAILED|PUBLISH FAILED' "$f" \
                        | head -15 | sed 's/^/        /'
                fi
            done < <(ls -1t "${LOGS_DIR}"/*.log 2>/dev/null | head -8)
            ;;
        *) _er "Usage: mirroretctl logs {list|tail|show|errors}"; return 1 ;;
    esac
}

